{
  "name": "qingshan-blog",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "new:post": "node scripts/new-post.js",
    "new:debug": "node scripts/new-post.js --type=debug",
    "new:source": "node scripts/new-post.js --type=source",
    "new:arch": "node scripts/new-post.js --type=arch",
    "new:tutorial": "node scripts/new-post.js --type=tutorial",
    "validate:posts": "node scripts/validate-posts.js",
    "generate:feeds": "node scripts/generate-feeds.js",
    "generate:search": "node scripts/generate-search-index.js",
    "check": "npm run validate:posts && npm run generate:feeds && npm run generate:search && npm run build",
    "prebuild": "npm run validate:posts && npm run generate:feeds && npm run generate:search",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest"
  },
  "devDependencies": {}
}
